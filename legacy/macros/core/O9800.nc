%
O9800 (LIB INIT - DEFAULTS ONLY; NO MOTION)
(NO AXIS MOTION AND NO PROBE M-CODES ARE USED IN THIS MACRO.)

#585 = 1 (DEFAULT STATUS=OK; SET NEGATIVE ON WARN/ERROR)
IF[#500 NE 0] GOTO 100
#500 = 9800.01 (SET LIB_VERSION DEFAULT IF UNSET)
N100
IF[#501 NE 0] GOTO 101
#501 = 1 (SET LIB_VERBOSE DEFAULT IF UNSET)
N101
IF[#510 NE 0] GOTO 102
#510 = 1 (SET UNITS_MODE DEFAULT IF UNSET: 1=INCH, 2=MM)
N102

IF[[#510 EQ 1] OR [#510 EQ 2]] GOTO 110
#585 = -510 (INVALID UNITS_MODE)
#3000 = 510 (O9800 ALARM: UNITS_MODE MUST BE 1 OR 2)
N110

IF[[#530 NE 0] OR [#510 NE 1]] GOTO 120
#530 = 10.0 (SET PROBE_SEEK_FEED DEFAULT IN INCH)
N120
IF[[#530 NE 0] OR [#510 NE 2]] GOTO 121
#530 = 254.0 (SET PROBE_SEEK_FEED DEFAULT IN MM)
N121
IF[[#531 NE 0] OR [#510 NE 1]] GOTO 122
#531 = 50.0 (SET PROBE_RETRACT_FEED DEFAULT IN INCH)
N122
IF[[#531 NE 0] OR [#510 NE 2]] GOTO 123
#531 = 1270.0 (SET PROBE_RETRACT_FEED DEFAULT IN MM)
N123
IF[[#532 NE 0] OR [#510 NE 1]] GOTO 124
#532 = 0.050 (SET PROBE_MAX_STROKE DEFAULT IN INCH)
N124
IF[[#532 NE 0] OR [#510 NE 2]] GOTO 125
#532 = 1.27 (SET PROBE_MAX_STROKE DEFAULT IN MM)
N125
IF[[#533 NE 0] OR [#510 NE 1]] GOTO 126
#533 = 0.200 (SET TS_MAX_STROKE DEFAULT IN INCH)
N126
IF[[#533 NE 0] OR [#510 NE 2]] GOTO 127
#533 = 5.08 (SET TS_MAX_STROKE DEFAULT IN MM)
N127
IF[#534 NE 0] GOTO 128
#534 = 3 (SET MAX_RETRIES DEFAULT IF UNSET)
N128

IF[#526 NE 0] GOTO 129
#585 = -526 (SAFE_Z_MACHINE_IN IS UNSET)
N129
IF[[#526 NE 0] OR [#501 EQ 0]] GOTO 130
#3006 = 1 (RUN O9803 TO SET SAFE_Z_MACHINE)
N130

M99 (RETURN FROM MACRO)
%
