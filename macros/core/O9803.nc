%
O9803 (SET SAFE_Z_MACHINE_IN; NO MOTION)
(INPUT: A=#1 SAFE_Z_MACHINE_IN - INCHES, MACHINE COORDINATE)
(POLICY: OPERATORS ENTER INCHES; STORE #526 INCH AND #527 MM MIRROR)
(POLICY: NO AXIS MOTION; NO G/M CODES; END WITH M99)

(---- VALIDATE INPUT ----)
IF[#1 EQ 0] GOTO 900

(---- STORE SAFE_Z ----)
#526 = #1 (STORE SAFE_Z_MACHINE_IN, INCHES)
#527 = [#1 * 25.4] (STORE SAFE_Z_MACHINE_MM MIRROR)
#585 = 1 (LAST_STATUS OK)

(---- OPTIONAL OPERATOR MESSAGE ----)
IF[#501 NE 0] GOTO 910
GOTO 920
N910
#3006 = 1 (O9803 OK: SAFE_Z_IN=#526 SAFE_Z_MM=#527)
N920

M99 (RETURN)

N900
#585 = -9803 (ERROR: SAFE_Z INPUT MISSING/ZERO)
#3000 = 9803 (O9803 ALARM: A SAFE_Z_MACHINE_IN REQUIRED)
M99 (RETURN)
%
