%
O9800 (LIB INIT - DEFAULTS ONLY; NO MOTION)
(NO AXIS MOTION AND NO PROBE M-CODES ARE USED IN THIS MACRO.)

#585 = 1 (DEFAULT STATUS=OK; SET NEGATIVE ON WARN/ERROR)
IF[#500 EQ 0] THEN #500 = 9800.01 (SET LIB_VERSION DEFAULT IF UNSET)
IF[#501 EQ 0] THEN #501 = 1 (SET LIB_VERBOSE DEFAULT IF UNSET)
IF[#510 EQ 0] THEN #510 = 1 (SET UNITS_MODE DEFAULT IF UNSET: 1=INCH, 2=MM)

IF[[#510 NE 1] AND [#510 NE 2]] THEN #585 = -510 (INVALID UNITS_MODE)
IF[[#510 NE 1] AND [#510 NE 2]] THEN #3000 = 510 (O9800 ALARM: UNITS_MODE MUST BE 1 OR 2)

IF[[#530 EQ 0] AND [#510 EQ 1]] THEN #530 = 10.0 (SET PROBE_SEEK_FEED DEFAULT IN INCH)
IF[[#530 EQ 0] AND [#510 EQ 2]] THEN #530 = 254.0 (SET PROBE_SEEK_FEED DEFAULT IN MM)
IF[[#531 EQ 0] AND [#510 EQ 1]] THEN #531 = 50.0 (SET PROBE_RETRACT_FEED DEFAULT IN INCH)
IF[[#531 EQ 0] AND [#510 EQ 2]] THEN #531 = 1270.0 (SET PROBE_RETRACT_FEED DEFAULT IN MM)
IF[[#532 EQ 0] AND [#510 EQ 1]] THEN #532 = 0.050 (SET PROBE_MAX_STROKE DEFAULT IN INCH)
IF[[#532 EQ 0] AND [#510 EQ 2]] THEN #532 = 1.27 (SET PROBE_MAX_STROKE DEFAULT IN MM)
IF[[#533 EQ 0] AND [#510 EQ 1]] THEN #533 = 0.200 (SET TS_MAX_STROKE DEFAULT IN INCH)
IF[[#533 EQ 0] AND [#510 EQ 2]] THEN #533 = 5.08 (SET TS_MAX_STROKE DEFAULT IN MM)
IF[#534 EQ 0] THEN #534 = 3 (SET MAX_RETRIES DEFAULT IF UNSET)

IF[#526 EQ 0] THEN #585 = -526 (SAFE_Z_MACHINE_IN IS UNSET)
IF[[#526 EQ 0] AND [#501 NE 0]] THEN #3006 = 1 (RUN O9803 TO SET SAFE_Z_MACHINE)

M99 (RETURN FROM MACRO)
%
