%
O9802 (LIB ALARM HANDLER - RETRACT THEN ALARM)
(INPUTS: A=#1 INTERNAL_ERROR_CODE, B=#2 ALARM_CODE, C=#3 CONTEXT_1, D=#4 CONTEXT_2)

#511 = #1 (LOG INTERNAL ERROR CODE FROM A)
#512 = #2 (LOG ALARM CODE FROM B)
#585 = -ABS[#1] (SET LAST_STATUS NEGATIVE INTERNAL ERROR)

IF[#526 EQ 0] GOTO 10 (SAFE_Z UNSET -> SKIP RETRACT)
G53 G0 Z[#526] (RETRACT TO SAFE_Z_MACHINE_IN USING MACHINE COORDINATES)
N10

#3000 = #2 (O9802 ALARM - SEE #511/#512 FOR DETAILS)
M99 (RETURN)
%
