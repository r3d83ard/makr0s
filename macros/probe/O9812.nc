%
O9812 (PROBE PRIMITIVE SIGNED G31)
(ARGS: A=#1 AXIS 1=X 2=Y 3=Z)
(ARGS: B=#2 STROKE SIGNED CURRENT UNITS)
(ARGS: C=#3 MODE 1=PROBE 2=TOOLSETTER)
(ARGS: D=#7 FEED OVERRIDE 0=USE #530)
(REQ: USE G91 FOR STROKE; EXIT G90 AND G94)
(REQ: M19 BEFORE EACH G31)
(REQ: NO PROBE ENABLE M-CODES; NO PMC READS)

(---- COMMISSIONING LOGS ----)
#580 = #580 + 1 (LOG RUN COUNTER)
#581 = #1 (LOG INPUT A)
#582 = #2 (LOG INPUT B)
#583 = #3 (LOG INPUT C)
#584 = 0 (LOG HIT POSITION DEFAULT 0)
#585 = 0 (STATUS RESET)

(---- INPUT VALIDATION ----)
IF[#1 LT 1] GOTO 900
IF[#1 GT 3] GOTO 900
IF[#3 EQ 1] GOTO 905
IF[#3 EQ 2] GOTO 905
GOTO 901
N905
IF[#2 EQ 0] GOTO 902
IF[#526 EQ 0] GOTO 903

(---- SELECT MAX STROKE ----)
#10 = #532 (MAX STROKE DEFAULT PROBE)
IF[#3 NE 2] GOTO 210
#10 = #533 (MAX STROKE TOOLSETTER)
N210

#30 = #2 (REQUESTED STROKE)
#31 = 1 (STROKE SIGN DEFAULT POSITIVE)
IF[#30 GE 0] GOTO 220
#31 = -1 (STROKE SIGN NEGATIVE)
#30 = -#30 (ABS REQUESTED STROKE)
N220
IF[#30 LE #10] GOTO 230
#30 = #10 (CAP STROKE TO MAX)
N230
#32 = #30 (ABS STROKE)
#33 = #32 (SIGNED STROKE DEFAULT POSITIVE)
IF[#31 GE 0] GOTO 240
#33 = -#32 (SIGNED STROKE NEGATIVE)
N240

(---- TRAVEL THRESHOLDS ----)
#20 = 0.001 (IMMEDIATE HIT THRESHOLD INCH)
#21 = 0.0005 (NO TRIGGER TOLERANCE INCH)
IF[#510 NE 2] GOTO 250
#20 = 0.02 (IMMEDIATE HIT THRESHOLD MM)
#21 = 0.01 (NO TRIGGER TOLERANCE MM)
N250
#22 = #32 - #21 (NO TRIGGER THRESHOLD)
IF[#22 GE 0] GOTO 255
#22 = 0 (CLAMP NO TRIGGER THRESHOLD)
N255
#23 = #20 + #20 (SKIP STUCK CHECK STROKE)

(---- SELECT FEED ----)
#24 = #7 (INPUT D FEED OVERRIDE)
#25 = #24 (FEED TO USE)
IF[#25 NE 0] GOTO 260
#25 = #530 (DEFAULT FEED)
N260

(---- START POSITION CAPTURE ----)
IF[#1 EQ 1] GOTO 310
IF[#1 EQ 2] GOTO 320
IF[#1 EQ 3] GOTO 330
GOTO 900
N310
#26 = #5041 (START X POSITION)
GOTO 340
N320
#26 = #5042 (START Y POSITION)
GOTO 340
N330
#26 = #5043 (START Z POSITION)
N340

G91 (G91 INCREMENTAL MODE FOR STROKE)
G94 (G94 FEED PER MINUTE FOR G31)
M19 (SPINDLE ORIENT BEFORE G31)

IF[#1 EQ 1] GOTO 410
IF[#1 EQ 2] GOTO 420
IF[#1 EQ 3] GOTO 430
GOTO 900

N410
G31 X#33 F#25 (G31 SKIP MOVE X SIGNED)
GOTO 440
N420
G31 Y#33 F#25 (G31 SKIP MOVE Y SIGNED)
GOTO 440
N430
G31 Z#33 F#25 (G31 SKIP MOVE Z SIGNED)
N440

(---- END POSITION CAPTURE ----)
IF[#1 EQ 1] GOTO 510
IF[#1 EQ 2] GOTO 520
IF[#1 EQ 3] GOTO 530
GOTO 900
N510
#27 = #5041 (END X POSITION)
GOTO 540
N520
#27 = #5042 (END Y POSITION)
GOTO 540
N530
#27 = #5043 (END Z POSITION)
N540

#28 = #27 - #26 (ACTUAL TRAVEL)
IF[#28 GE 0] GOTO 550
#28 = -#28 (ABS ACTUAL TRAVEL)
N550

IF[#28 GT #20] GOTO 560
GOTO 906 (SKIP ACTIVE OR IMMEDIATE HIT)
N560
IF[#28 GE #22] GOTO 904 (NO TRIGGER)
IF[#1 EQ 1] GOTO 610
IF[#1 EQ 2] GOTO 620
IF[#1 EQ 3] GOTO 630
GOTO 900
N610
#584 = #5041 (HIT POSITION MACHINE COORD X)
GOTO 640
N620
#584 = #5042 (HIT POSITION MACHINE COORD Y)
GOTO 640
N630
#584 = #5043 (HIT POSITION MACHINE COORD Z)
N640

(---- RETRACT TO SAFE Z ----)
G90 (G90 ABSOLUTE MODE FOR SAFE Z)
G53 G0 Z#526 (G53 G0 RETRACT TO SAFE Z)
G94 (G94 FEED PER MINUTE)

(---- SKIP STUCK CHECK AFTER RETRACT ----)
#16 = #5023 (CHECK START Z POSITION)
G91 (G91 INCREMENTAL MODE FOR CHECK)
G94 (G94 FEED PER MINUTE FOR G31)
M19 (SPINDLE ORIENT BEFORE G31 CHECK)
G31 Z#23 F#25 (G31 SKIP CHECK Z PLUS)
G90 (G90 ABSOLUTE MODE AFTER CHECK)
#17 = #5023 (CHECK END Z POSITION)
#18 = #17 - #16 (CHECK TRAVEL)
IF[#18 GE 0] GOTO 650
#18 = -#18 (ABS CHECK TRAVEL)
N650
IF[#18 GT #20] GOTO 660
GOTO 907 (SKIP STUCK AFTER RETRACT)
N660
G53 G0 Z#526 (G53 G0 RETRACT TO SAFE Z)
G94 (G94 FEED PER MINUTE ON EXIT)
#585 = 1 (STATUS OK)
M99 (RETURN)

N900
G90 (G90 ABSOLUTE MODE BEFORE FAULT)
G94 (G94 FEED PER MINUTE BEFORE FAULT)
G65 P9802 A923 B923 (G65 CALL O9802 AXIS INVALID)
M99 (RETURN)

N901
G90 (G90 ABSOLUTE MODE BEFORE FAULT)
G94 (G94 FEED PER MINUTE BEFORE FAULT)
G65 P9802 A924 B924 (G65 CALL O9802 MODE INVALID)
M99 (RETURN)

N902
G90 (G90 ABSOLUTE MODE BEFORE FAULT)
G94 (G94 FEED PER MINUTE BEFORE FAULT)
G65 P9802 A925 B925 (G65 CALL O9802 STROKE ZERO)
M99 (RETURN)

N903
G90 (G90 ABSOLUTE MODE BEFORE FAULT)
G94 (G94 FEED PER MINUTE BEFORE FAULT)
G65 P9802 A920 B920 (G65 CALL O9802 SAFE Z NOT SET)
M99 (RETURN)

N904
G90 (G90 ABSOLUTE MODE BEFORE FAULT)
G94 (G94 FEED PER MINUTE BEFORE FAULT)
G65 P9802 A921 B921 (G65 CALL O9802 NO TRIGGER)
M99 (RETURN)

N906
G90 (G90 ABSOLUTE MODE BEFORE FAULT)
G94 (G94 FEED PER MINUTE BEFORE FAULT)
G65 P9802 A926 B926 (G65 CALL O9802 SKIP ACTIVE)
M99 (RETURN)

N907
G90 (G90 ABSOLUTE MODE BEFORE FAULT)
G94 (G94 FEED PER MINUTE BEFORE FAULT)
G65 P9802 A927 B927 (G65 CALL O9802 SKIP STUCK)
M99 (RETURN)
%
