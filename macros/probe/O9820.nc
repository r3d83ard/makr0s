%
O9820 (PROBE CALIBRATION - MASTER RING AND TEST BAR)
(ARGS: A=#1 MODE 1=INCH)
(ARGS: B=#2 RING ID INCH)
(ARGS: C=#3 RING CENTER X MACHINE)
(ARGS: D=#7 RING CENTER Y MACHINE)
(ARGS: E=#8 Z REF MACHINE)
(ARGS: F=#9 TEST BAR LENGTH)
(REQ: USE O9812 FOR CENTER FIND; USE O9810 FOR Z PROBE)

(---- RUN LOGGING ----)
#580 = #580 + 1 (LOG RUN COUNTER)
#581 = #1 (LOG INPUT A)
#582 = #2 (LOG INPUT B)
#583 = #3 (LOG INPUT C)
#584 = #7 (LOG INPUT D)
#585 = 0 (STATUS RESET)

(---- INPUT VALIDATION ----)
IF[#1 NE 1] GOTO 900
IF[#2 EQ 0] GOTO 901
IF[#8 EQ 0] GOTO 903
IF[#9 EQ 0] GOTO 904
IF[#526 EQ 0] GOTO 905
IF[#528 EQ 0] GOTO 908

(---- CENTER FIND FLAG ----)
#29 = 0 (CENTER FIND FLAG)
IF[#3 NE 0] GOTO 90
#29 = 1 (CENTER FIND NEEDED)
N90
IF[#7 NE 0] GOTO 95
#29 = 1 (CENTER FIND NEEDED)
N95

(---- UNIT NORMALIZATION ----)
#20 = #2 (RING DIAMETER WORKING UNITS)
#21 = #3 (CENTER X WORKING UNITS)
#22 = #7 (CENTER Y WORKING UNITS)
#23 = #8 (Z REF WORKING UNITS)
#24 = #9 (TEST BAR LENGTH WORKING UNITS)
#25 = 0.059055 (NOMINAL BALL RADIUS INCH - 3MM DIA RUBY)
IF[#510 NE 2] GOTO 100
#20 = #2 * 25.4 (RING DIAMETER IN MM)
#23 = #8 * 25.4 (Z REF IN MM)
#24 = #9 * 25.4 (TEST BAR LENGTH IN MM)
#25 = 1.5 (NOMINAL BALL RADIUS MM - 3MM DIA RUBY)
IF[#29 NE 0] GOTO 100
#21 = #3 * 25.4 (CENTER X IN MM)
#22 = #7 * 25.4 (CENTER Y IN MM)
N100

IF[#29 EQ 0] GOTO 110
#21 = #5021 (NEAR CENTER X FROM CURRENT)
#22 = #5022 (NEAR CENTER Y FROM CURRENT)
N110

#26 = #20 / 2 (RING RADIUS)
#28 = #532 / 2 (HALF STROKE)
#27 = #26 - #25 - #28 (APPROACH OFFSET BASE)
#4 = #529 (APPROACH CLEARANCE)
IF[#4 NE 0] GOTO 115
#4 = 0.050 (APPROACH CLEARANCE INCH)
IF[#510 NE 2] GOTO 115
#4 = 1.27 (APPROACH CLEARANCE MM)
N115
#27 = #27 - #4 (APPROACH OFFSET FINAL WITH CLEARANCE)
IF[#27 LE 0] GOTO 906

#10 = #4 * 3 (STROKE MAGNITUDE)
IF[#10 LE 0] GOTO 906
IF[#10 LE #532] GOTO 120
#10 = #532 (CAP STROKE TO MAX)
N120
#11 = -#10 (NEGATIVE STROKE)

(---- PROBE X- WALL ----)
G53 G0 Z#526 (G53 G0 SAFE Z BEFORE XY MOVE)
#12 = #21 - #27 (X APPROACH POSITION MINUS)
G53 G0 X#12 Y#22 (G53 G0 APPROACH X MINUS)
G53 G0 Z#528 (DROP TO PROBE Z PLANE FOR WALL TOUCH)
G65 P9812 A1 B#11 C1 D0 (G65 CALL O9812 X MINUS)
#30 = #5061 (X MINUS HIT POSITION)

(---- PROBE X+ WALL ----)
G53 G0 Z#526 (G53 G0 SAFE Z BEFORE XY MOVE)
#13 = #21 + #27 (X APPROACH POSITION PLUS)
G53 G0 X#13 Y#22 (G53 G0 APPROACH X PLUS)
G53 G0 Z#528 (DROP TO PROBE Z PLANE FOR WALL TOUCH)
G65 P9812 A1 B#10 C1 D0 (G65 CALL O9812 X PLUS)
#31 = #5061 (X PLUS HIT POSITION)

IF[#29 EQ 0] GOTO 151
#21 = #30 + #31 (CENTER X SUM)
#21 = #21 / 2 (CENTER X)
N151

(---- PROBE Y- WALL ----)
G53 G0 Z#526 (G53 G0 SAFE Z BEFORE XY MOVE)
#14 = #22 - #27 (Y APPROACH POSITION MINUS)
G53 G0 X#21 Y#14 (G53 G0 APPROACH Y MINUS)
G53 G0 Z#528 (DROP TO PROBE Z PLANE FOR WALL TOUCH)
G65 P9812 A2 B#11 C1 D0 (G65 CALL O9812 Y MINUS)
#32 = #5062 (Y MINUS HIT POSITION)

(---- PROBE Y+ WALL ----)
G53 G0 Z#526 (G53 G0 SAFE Z BEFORE XY MOVE)
#15 = #22 + #27 (Y APPROACH POSITION PLUS)
G53 G0 X#21 Y#15 (G53 G0 APPROACH Y PLUS)
G53 G0 Z#528 (DROP TO PROBE Z PLANE FOR WALL TOUCH)
G65 P9812 A2 B#10 C1 D0 (G65 CALL O9812 Y PLUS)
#33 = #5062 (Y PLUS HIT POSITION)

IF[#29 EQ 0] GOTO 161
#22 = #32 + #33 (CENTER Y SUM)
#22 = #22 / 2 (CENTER Y)
N161

#16 = #31 - #30 (MEASURED DIAMETER X)
#17 = #33 - #32 (MEASURED DIAMETER Y)
#18 = #20 - #16 (EFFECTIVE DIAMETER X)
#18 = #18 / 2 (EFFECTIVE RADIUS X)
#19 = #20 - #17 (EFFECTIVE DIAMETER Y)
#19 = #19 / 2 (EFFECTIVE RADIUS Y)
#18 = #18 + #19 (RADIUS SUM)
#18 = #18 / 2 (RADIUS AVG)
#540 = #18 (STORE STYLUS RADIUS)

(---- PROBE Z REFERENCE ----)
G53 G0 Z#526 (G53 G0 SAFE Z BEFORE Z MOVE)
G53 G0 X#21 Y#22 (G53 G0 RETURN TO CENTER)
#16 = #23 + #24 + #28 (Z START ABOVE SURFACE)
#18 = #524 (Z MIN LIMIT MM)
#19 = #525 (Z MAX LIMIT MM)
IF[#18 EQ 0] GOTO 907
IF[#19 EQ 0] GOTO 907
IF[#510 EQ 2] GOTO 710
#18 = #18 / 25.4 (Z MIN LIMIT IN)
#19 = #19 / 25.4 (Z MAX LIMIT IN)
N710
IF[#18 LT #19] GOTO 720
GOTO 907
N720
IF[#16 GE #18] GOTO 730
#16 = #18 (CLAMP Z START TO MIN)
N730
IF[#16 LE #19] GOTO 740
#16 = #19 (CLAMP Z START TO MAX)
N740
G53 G0 Z#16 (G53 G0 APPROACH Z START)
G65 P9810 A3 B#532 C1 D0 (G65 CALL O9810 Z MINUS)
#18 = #5063 (Z HIT POSITION)
#17 = #23 + #24 (Z REFERENCE STACK)
#541 = #17 - #18 (STORE STYLUS LENGTH)

#583 = #540 (LOG RESULT 1)
#584 = #541 (LOG RESULT 2)
#585 = 1 (STATUS OK)
G90 (G90 ABSOLUTE MODE ON EXIT)
G94 (G94 FEED PER MINUTE ON EXIT)
M99 (M99 RETURN)

N900
G90 (G90 ABSOLUTE MODE BEFORE FAULT)
G94 (G94 FEED PER MINUTE BEFORE FAULT)
G65 P9802 A940 B940 (G65 CALL O9802 MODE INVALID)
M99 (M99 RETURN)

N901
G90 (G90 ABSOLUTE MODE BEFORE FAULT)
G94 (G94 FEED PER MINUTE BEFORE FAULT)
G65 P9802 A941 B941 (G65 CALL O9802 RING ID MISSING)
M99 (M99 RETURN)

N902
G90 (G90 ABSOLUTE MODE BEFORE FAULT)
G94 (G94 FEED PER MINUTE BEFORE FAULT)
G65 P9802 A942 B942 (G65 CALL O9802 CENTER MISSING)
M99 (M99 RETURN)

N903
G90 (G90 ABSOLUTE MODE BEFORE FAULT)
G94 (G94 FEED PER MINUTE BEFORE FAULT)
G65 P9802 A943 B943 (G65 CALL O9802 Z REF MISSING)
M99 (M99 RETURN)

N904
G90 (G90 ABSOLUTE MODE BEFORE FAULT)
G94 (G94 FEED PER MINUTE BEFORE FAULT)
G65 P9802 A944 B944 (G65 CALL O9802 TEST BAR MISSING)
M99 (M99 RETURN)

N905
G90 (G90 ABSOLUTE MODE BEFORE FAULT)
G94 (G94 FEED PER MINUTE BEFORE FAULT)
G65 P9802 A920 B920 (G65 CALL O9802 SAFE Z NOT SET)
M99 (M99 RETURN)

N906
G90 (G90 ABSOLUTE MODE BEFORE FAULT)
G94 (G94 FEED PER MINUTE BEFORE FAULT)
G65 P9802 A945 B945 (G65 CALL O9802 APPROACH OFFSET INVALID)
M99 (M99 RETURN)

N907
G90 (G90 ABSOLUTE MODE BEFORE FAULT)
G94 (G94 FEED PER MINUTE BEFORE FAULT)
G65 P9802 A946 B946 (G65 CALL O9802 Z LIMITS INVALID)
M99 (M99 RETURN)

N908
G90 (G90 ABSOLUTE MODE BEFORE FAULT)
G94 (G94 FEED PER MINUTE BEFORE FAULT)
G65 P9802 A947 B947 (PROBE Z PLANE NOT SET - SET #528)
M99 (RETURN)
%
