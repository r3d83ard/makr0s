%
O9810 (PROBE PRIMITIVE - SINGLE AXIS G31)
(ARGS: A=#1 AXIS 1=X, 2=Y, 3=Z)
(ARGS: B=#2 STROKE DISTANCE POSITIVE, CURRENT UNITS)
(ARGS: C=#3 MODE 1=PROBE USES #532, 2=TOOLSETTER USES #533)
(ARGS: D=#7 FEED OVERRIDE, 0=USE #530)
(DIR: X/Y MOVE +B, Z MOVE -B - Z DOWN IS NEGATIVE)
(REQ: USE G91 FOR STROKE; EXIT G90 AND G94)
(REQ: NO PROBE-ENABLE M-CODES; NO PMC READS)

(---- COMMISSIONING LOGS ----)
#580 = #580 + 1 (LOG: INCREMENT RUN COUNTER)
#581 = #1 (LOG: AXIS A)
#582 = #2 (LOG: STROKE REQUEST B)
#583 = #3 (LOG: MODE C)
#584 = 0 (LOG: HIT POSITION DEFAULT 0)
#8 = 0 (INIT: START POSITION)
#9 = 0 (INIT: END POSITION)
#10 = 0 (INIT: ACTUAL TRAVEL)
#11 = 0 (INIT: TRAVEL TOLERANCE)
#12 = 0 (INIT: NO-TRIGGER THRESHOLD)

(REQ: ALARM CODE 922 - SKIP STUCK - RESERVED; NOT USED IN PHASE 2)

(---- INPUT VALIDATION ----)
IF[#1 LT 1] GOTO 900
IF[#1 GT 3] GOTO 900
IF[#3 EQ 1] GOTO 905
IF[#3 EQ 2] GOTO 905
GOTO 901
N905
IF[#2 EQ 0] GOTO 902

(---- SAFE_Z CHECK ----)
IF[#526 EQ 0] GOTO 903

(---- SELECT MAX STROKE ----)
#5 = #532 (MAX STROKE DEFAULT: PROBE)
IF[#3 NE 2] GOTO 210
#5 = #533 (MAX STROKE FOR TOOLSETTER MODE)
N210

#6 = #2 (REQUESTED STROKE)
IF[#6 GE 0] GOTO 220
#6 = -#6 (ENFORCE POSITIVE STROKE)
N220
IF[#6 LE #5] GOTO 230
#6 = #5 (CAP STROKE TO MAX)
N230

(---- TRAVEL TOLERANCE ----)
#11 = 0.0005 (TOLERANCE IN INCH MODE)
IF[#510 NE 2] GOTO 240
#11 = 0.01 (TOLERANCE IN MM MODE)
N240
#12 = #6 - #11 (NO-TRIGGER THRESHOLD)
IF[#12 GE 0] GOTO 250
#12 = 0 (CLAMP THRESHOLD)
N250

(---- SELECT FEED ----)
#20 = #7 (INPUT: D FEED OVERRIDE)
#21 = #20 (FEED TO USE)
IF[#21 NE 0] GOTO 260
#21 = #530 (DEFAULT FEED FROM #530)
N260

(---- START POSITION CAPTURE ----)
IF[#1 EQ 1] GOTO 310
IF[#1 EQ 2] GOTO 320
IF[#1 EQ 3] GOTO 330
GOTO 900 (SHOULD NOT HAPPEN - AXIS ALREADY VALIDATED)
N310
#8 = #5021 (START X POSITION)
GOTO 340
N320
#8 = #5022 (START Y POSITION)
GOTO 340
N330
#8 = #5023 (START Z POSITION)
N340

G91 (G91 = INCREMENTAL MODE FOR BOUNDED STROKE)
G94 (G94 = FEED PER MINUTE FOR G31 MOVE)
M19 (SPINDLE ORIENT BEFORE G31)

IF[#1 EQ 1] GOTO 110
IF[#1 EQ 2] GOTO 120
IF[#1 EQ 3] GOTO 130
GOTO 900 (SHOULD NOT HAPPEN - AXIS ALREADY VALIDATED)

N110
G31 X#6 F#21 (G31 = SKIP MOVE +X AT FEED)
GOTO 140

N120
G31 Y#6 F#21 (G31 = SKIP MOVE +Y AT FEED)
GOTO 140

N130
#13 = -#6 (NEGATIVE Z STROKE)
G31 Z#13 F#21 (G31 = SKIP MOVE -Z AT FEED)
GOTO 140

N140

(---- END POSITION CAPTURE ----)
IF[#1 EQ 1] GOTO 350
IF[#1 EQ 2] GOTO 360
IF[#1 EQ 3] GOTO 370
GOTO 900 (SHOULD NOT HAPPEN - AXIS ALREADY VALIDATED)
N350
#9 = #5021 (END X POSITION)
GOTO 380
N360
#9 = #5022 (END Y POSITION)
GOTO 380
N370
#9 = #5023 (END Z POSITION)
N380

#10 = #9 - #8 (ACTUAL TRAVEL)
IF[#10 GE 0] GOTO 390
#10 = -#10 (ABS ACTUAL TRAVEL)
N390

IF[#10 GE #12] GOTO 410
IF[#1 EQ 1] GOTO 411
IF[#1 EQ 2] GOTO 412
IF[#1 EQ 3] GOTO 413
GOTO 900 (SHOULD NOT HAPPEN - AXIS ALREADY VALIDATED)
N411
#584 = #5061 (LOG: HIT POSITION X)
GOTO 414
N412
#584 = #5062 (LOG: HIT POSITION Y)
GOTO 414
N413
#584 = #5063 (LOG: HIT POSITION Z)
N414
GOTO 415
N410
#584 = 0 (LOG: NO HIT CAPTURED)
GOTO 904
N415

(---- RETRACT TO SAFE Z ----)
G90 (G90 = ABSOLUTE MODE FOR SAFE-Z RETRACT)
G53 G0 Z#526 (G53 = MACHINE COORDS, G0 = RAPID RETRACT TO SAFE_Z)
G94 (G94 = FEED PER MINUTE ON EXIT)

#585 = 1 (STATUS OK)

M99 (RETURN FROM MACRO)

N900
G90 (G90 = ABSOLUTE MODE BEFORE FAULT)
G94 (G94 = FEED PER MINUTE BEFORE FAULT)
G65 P9802 A923 B923 (G65 = MACRO CALL; A AXIS INVALID)
M99 (RETURN FROM MACRO)

N901
G90 (G90 = ABSOLUTE MODE BEFORE FAULT)
G94 (G94 = FEED PER MINUTE BEFORE FAULT)
G65 P9802 A924 B924 (G65 = MACRO CALL; C MODE INVALID)
M99 (RETURN FROM MACRO)

N902
G90 (G90 = ABSOLUTE MODE BEFORE FAULT)
G94 (G94 = FEED PER MINUTE BEFORE FAULT)
G65 P9802 A925 B925 (G65 = MACRO CALL; B STROKE ZERO)
M99 (RETURN FROM MACRO)

N903
G90 (G90 = ABSOLUTE MODE BEFORE FAULT)
G94 (G94 = FEED PER MINUTE BEFORE FAULT)
G65 P9802 A920 B920 (G65 = MACRO CALL; SAFE_Z NOT SET)
M99 (RETURN FROM MACRO)

N904
G90 (G90 = ABSOLUTE MODE BEFORE FAULT)
G94 (G94 = FEED PER MINUTE BEFORE FAULT)
G65 P9802 A921 B921 (G65 = MACRO CALL; NO TRIGGER)
M99 (RETURN FROM MACRO)
%
